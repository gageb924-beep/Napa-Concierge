ANTHROPIC_API_KEY=sk-ant-...
ADMIN_API_KEY=pick-a-long-random-string
# Twilio (leave blank to run in dry-run mode: texts are logged instead of sent)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Public URL of this server, used for Twilio signature checks, e.g. https://missed-call-ai.onrender.com
PUBLIC_BASE_URL=
# Optional
CLAUDE_MODEL=claude-sonnet-5-5
DATABASE_URL=sqlite:///./missed_call_ai.db
